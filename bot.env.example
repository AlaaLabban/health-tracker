# Copy to bot.env (chmod 600). Read by health-bot.service.
# Token from @BotFather: set it with ./set-token.sh, which does not echo it.
TELEGRAM_TOKEN=
# Your own chat id. Leave empty, send the bot /start, then read it from
# `journalctl -u health-bot` ("message from chat N ignored").
CHAT_ID=
DB_PATH=/opt/health-tracker/health.db
# TRACKER_CONFIG=/opt/health-tracker/tracker.json   # default: tracker.json, else tracker.example.json
UTC_OFFSET_HOURS=3
# Card at ASK_AT, a fresh card at REMIND_AT if the day is still empty, and at CALL_AT the next day
# a phone call (only when ASTERISK_SPOOL is set; see docs/PHONE.md).
ASK_AT=20:00
REMIND_AT=22:00
CALL_AT=15:00
# ASTERISK_SPOOL=/opt/phone-ai-gateway/spool
# Free text goes to `claude -p`. Use a dedicated config dir; the bot refuses any account but ALLOWED_EMAIL.
CLAUDE_CONFIG_DIR=
ALLOWED_EMAIL=you@example.com
CLAUDE_MODEL=sonnet
DAILY_CAP=40
# Mini App (optional): served on WEBAPP_BIND:WEBAPP_PORT, published by your reverse proxy at WEBAPP_URL.
# WEBAPP_URL=https://health.example.com
# WEBAPP_BIND=127.0.0.1
# WEBAPP_PORT=8097
# FORCE_IPV4=1     # if your connection resets IPv6 connections to Telegram
# TIMING=1         # log each Telegram call's round trip
